# URL del nodo de la Blockchain (Ganache por defecto, o puedes usar Infura/Alchemy)
WEB3_PROVIDER_URL=http://127.0.0.1:8545

# Dirección del contrato CFPFactory desplegado en tu red local
CFP_FACTORY_ADDRESS=0x0717E625330D28C3E8d0C21249FB97418e4CDAe4

# Mnemónico de 12 palabras de tu billetera de desarrollo (por ejemplo, la que te da Ganache o Hardhat)
CFP_MNEMONIC="burden globe head ancient tired afford champion tenant patient among short over"

# Ruta de derivación estándar de Ethereum para HD Wallets
DERIVACION_PATH="m/44'/60'/0'/0/0"

# Ruta local donde se creará y guardará tu base de datos SQLite
CFP_DB_PATH="db/database.db"

# Dirección del administrador del sistema
CFP_ADMIN_ADDRESS=0xb798C6E8C2C2990346Ad33A6fEeC41917D809881

# Directorio local donde se almacenarán los archivos subidos a través de la API
PROPOSALS_UPLOAD_DIR = "uploaded_files"